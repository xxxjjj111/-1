{
  "name": "residual-shadow",
  "version": "1.0.0",
  "description": "残影 · 外发文件二次泄露体检台（桌面版）",
  "main": "electron-main.js",
  "author": "残影项目组",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env RESIDUAL_DEVTOOLS=1 electron .",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.residual.shadow",
    "productName": "残影体检台",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "lib/**/*",
      "samples/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "残影体检台-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  }
}
